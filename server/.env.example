# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Without it the API refuses to issue sessions rather than signing with a guessable key.
PANGEA_SESSION_SECRET=

# WebAuthn binds passkeys to one origin. RP_ID is the bare host, ORIGIN is the exact
# scheme+host+port the app is served from. Locally: localhost / http://localhost:5173.
PANGEA_RP_ID=pangea-session.netlify.app
PANGEA_ORIGIN=https://pangea-session.netlify.app
PANGEA_RP_NAME=Pangea

# The session cookie is cross-site in the deployed setup (Netlify app, separate API host),
# and browsers only send those when Secure + SameSite=None. Over plain http://localhost,
# set COOKIE_SECURE=false and COOKIE_SAMESITE=lax.
PANGEA_COOKIE_SECURE=true
PANGEA_COOKIE_SAMESITE=none

# Required to enrol the first passkey, so a deployed API cannot be claimed by a stranger.
PANGEA_ENROLL_CODE=

PANGEA_DB_PATH=pangea.db

# Broker stays off until both are set. Paper: 4002 (IB Gateway) or 7497 (TWS).
# Live: 4001 / 7496 — and nothing here changes a risk limit.
PANGEA_IBKR_HOST=
PANGEA_IBKR_PORT=
PANGEA_IBKR_PAPER=true

PANGEA_WATCHLIST=MES=F,MNQ=F,M6E=F,MGC=F
