{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pangea",
  "version": "0.1.0",
  "identifier": "com.pangea.session",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pangea",
        "width": 480,
        "height": 900,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0e1112"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "shortDescription": "Control surface for the SESSION trading platform",
    "category": "Finance"
  }
}
