# Base URL of the SESSION FastAPI service. Leave empty to run the app on the
# deterministic demo feed, which is labelled as demo everywhere it appears.
VITE_API_BASE=

# Device gate on the lock screen: 4-10 digits, nothing else (the keypad types digits only).
# Anything malformed is ignored in favour of the default, with a warning on the screen.
# This is not authentication — it ships in the bundle. The engine authenticates requests.
VITE_LOCK_PASSCODE=091285
